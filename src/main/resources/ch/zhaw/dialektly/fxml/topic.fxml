<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="ch.zhaw.dialektly.presenter.TopicPresenter"
            stylesheets="@../css/topic.css">
    <center>
        <ScrollPane fitToWidth="true" fitToHeight="true" style="-fx-background-color: transparent; -fx-control-inner-background: transparent;">
            <content>
                <VBox spacing="20" alignment="CENTER">
                    <padding>
                        <Insets top="60" right="40" bottom="40" left="40"/>
                    </padding>
                    <Label text="%topic.title" style="-fx-font-size: 22; -fx-font-weight: bold;"/>
                    <TilePane fx:id="topicTiles" prefColumns="3" hgap="14" vgap="14" alignment="CENTER"/>
                    <VBox alignment="CENTER" spacing="10">
                        <Label text="%topic.type" style="-fx-font-weight: bold; -fx-font-size: 16px;"/>
                        <HBox alignment="CENTER" spacing="14">
                            <ToggleButton fx:id="textToggle" text="%topic.textExercise"
                                          prefWidth="160" prefHeight="110"
                                          minWidth="80" minHeight="50"
                                          maxWidth="200" maxHeight="150"
                                          styleClass="topic-tile"/>
                            <ToggleButton fx:id="audioToggle" text="%topic.audioExercise"
                                          prefWidth="160" prefHeight="110"
                                          minWidth="80" minHeight="50"
                                          maxWidth="200" maxHeight="150"
                                          styleClass="topic-tile"/>
                        </HBox>
                    </VBox>
                    <Button fx:id="continueButton" text="%topic.btnContinue" onAction="#onContinueClicked"/>
                </VBox>
            </content>
        </ScrollPane>
    </center>
    <bottom>
        <HBox alignment="CENTER" spacing="20"
              style="-fx-background-color: #e8e8e8; -fx-padding: 12;">
            <Button text="%common.btnBack" onAction="#onBack" style="-fx-padding: 6 20 6 20;"/>
            <Button text="%home.btnLogout" onAction="#onLogout" style="-fx-padding: 6 20 6 20;"/>
            <Button text="%home.btnExit" onAction="#onExit"
                    style="-fx-padding: 6 20 6 20; -fx-background-color: #c0392b; -fx-text-fill: white;"/>
        </HBox>
    </bottom>
</BorderPane>