<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="ch.zhaw.dialektly.presenter.SummaryPresenter"
            style="-fx-background-color: #f5f5f5;">

    <top>
        <HBox style="-fx-background-color: #5a5a5a;"
              alignment="CENTER_LEFT">
            <Label text="%summary.title"
                   style="-fx-text-fill: white; -fx-font-size: 14px; -fx-padding: 12 24 12 24;"/>
        </HBox>
    </top>

    <center>
        <VBox alignment="CENTER" spacing="24"
              maxWidth="380"
              style="-fx-background-color: white; -fx-background-radius: 14; -fx-border-color: #d0d0d0; -fx-border-width: 2; -fx-border-radius: 14;">
            <BorderPane.margin>
                <Insets top="40" bottom="40" left="40" right="40"/>
            </BorderPane.margin>
            <padding>
                <Insets top="40" bottom="40" left="40" right="40"/>
            </padding>

            <Label text="%summary.success"
                   style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #333;"/>

            <Label fx:id="ratioLabel" text="0%"
                   style="-fx-font-size: 48px; -fx-font-weight: bold; -fx-text-fill: #4caf50;"/>

            <VBox alignment="CENTER" spacing="6">
                <Label fx:id="firstTryLabel" text="%summary.firstTry"
                       style="-fx-font-size: 16px; -fx-text-fill: #333;"/>
                <Label fx:id="masteredLabel" text="%summary.mastered"
                       style="-fx-font-size: 13px; -fx-text-fill: #888;"/>
            </VBox>

            <VBox fx:id="badgesSection" alignment="CENTER" spacing="8"
                  visible="false" managed="false">
                <Label text="%summary.newBadges"
                       style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #555;"/>
                <VBox fx:id="badgesContainer" alignment="CENTER" spacing="4"/>
            </VBox>
        </VBox>
    </center>

    <bottom>
        <HBox alignment="CENTER" spacing="40"
              style="-fx-background-color: #d0d0d0; -fx-padding: 16;">
            <Button fx:id="continueButton" text="%summary.btnBack"
                    style="-fx-background-color: #7a7a7a; -fx-text-fill: white; -fx-padding: 8 24 8 24;"
                    onAction="#onContinue"/>
        </HBox>
    </bottom>

</BorderPane>