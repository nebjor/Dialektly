<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            styleClass="main-shell"
            style="-fx-background-color: #f5f5f5;">

    <top>
        <HBox fillHeight="false" alignment="TOP_LEFT" style="-fx-background-color: #f5f5f5;">

            <HBox fx:id="logoBox" alignment="CENTER_LEFT"
                  style="-fx-padding: 4 16 8 16; -fx-cursor: hand;">
                <ImageView fitHeight="58" preserveRatio="true">
                    <image>
                        <Image url="@../images/dialektly-logo.png"/>
                    </image>
                </ImageView>
            </HBox>

            <HBox HBox.hgrow="ALWAYS" alignment="CENTER_LEFT"
                  prefHeight="56"
                  style="-fx-background-color: #5a5a5a;">

                <Label fx:id="headerModeLabel"
                       style="-fx-text-fill: white; -fx-font-size: 14px; -fx-padding: 0 16 0 16;"
                       maxHeight="Infinity"
                       visible="false" managed="false"/>

                <Label fx:id="headerTopicLabel"
                       style="-fx-background-color: #8a7a6a; -fx-text-fill: white; -fx-font-size: 14px; -fx-padding: 0 24 0 24;"
                       maxHeight="Infinity"
                       visible="false" managed="false"/>

                <HBox HBox.hgrow="ALWAYS" alignment="CENTER_RIGHT" style="-fx-padding: 0 16 0 0;">
                    <Button fx:id="languageToggle"
                            style="-fx-background-color: #787878; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-background-radius: 6; -fx-padding: 4 14 4 14; -fx-border-color: transparent;"/>
                </HBox>
            </HBox>

        </HBox>
    </top>

    <center>
        <StackPane fx:id="centerPane" style="-fx-background-color: #f5f5f5;"/>
    </center>
</BorderPane>