<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="ch.zhaw.dialektly.presenter.HomePresenter"
            stylesheets="@../css/progressbar.css">

    <center>
        <ScrollPane fitToWidth="true" fitToHeight="true" style="-fx-background-color: transparent; -fx-control-inner-background: transparent;">
            <content>
                <VBox spacing="20" alignment="CENTER">
                    <padding>
                        <Insets top="40" right="60" bottom="40" left="60"/>
                    </padding>

                    <Label fx:id="welcomeLabel" text="%home.welcome"
                           style="-fx-font-size: 24px; -fx-font-weight: bold;"/>

                    <Label fx:id="progressTitleLabel" text="%home.progress" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>

                    <HBox alignment="CENTER">
                        <VBox spacing="10">
                            <HBox alignment="CENTER_LEFT" spacing="12">
                                <Label text="%home.overall" style="-fx-font-weight: bold;" minWidth="100"/>
                                <ProgressBar fx:id="overallProgressBar" prefWidth="200" styleClass="progress-bar"/>
                                <Label fx:id="overallPercentageLabel" style="-fx-font-weight: bold;" minWidth="90"/>                            </HBox>
                            <Separator/>
                            <VBox fx:id="progressContainer" spacing="10"/>
                        </VBox>
                    </HBox>

                    <VBox spacing="10" alignment="CENTER">
                        <Label text="%home.badges"
                               style="-fx-font-size: 16px; -fx-font-weight: bold;"/>
                        <HBox alignment="CENTER">
                            <VBox fx:id="badgesContainer" spacing="6" alignment="CENTER_LEFT"/>
                        </HBox>
                    </VBox>

                    <Button fx:id="startSessionButton" text="%home.btnStart"
                            onAction="#onStartNewSession"
                            style="-fx-padding: 10 30 10 30; -fx-font-size: 14px;"/>
                </VBox>
            </content>
        </ScrollPane>
    </center>

    <bottom>
        <HBox alignment="CENTER" spacing="20"
              style="-fx-background-color: #e8e8e8; -fx-padding: 12;">
            <Button text="%home.btnLogout" onAction="#onLogout" style="-fx-padding: 6 20 6 20;"/>
            <Button text="%home.btnExit" onAction="#onExit"
                    style="-fx-padding: 6 20 6 20; -fx-background-color: #c0392b; -fx-text-fill: white;"/>
        </HBox>
    </bottom>

</BorderPane>